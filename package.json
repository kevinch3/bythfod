{
  "name": "bythfod",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "serve": "npx http-server -p 8123 -c-1",
    "contract:sync": "node tools/sync-contract.mjs",
    "contract:check": "node tools/sync-contract.mjs --check && node tools/gen-contract.mjs --check",
    "build:pages": "npm run build && node tools/build-static.mjs && node tools/assert-public-build.mjs",
